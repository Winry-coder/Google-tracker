# Access Tracker Pulse - Environment Configuration Template
# Copy this file to .env and fill in the values.
# NEVER commit your actual .env file to version control.

# ============================================
# 🔐 AUTHENTICATION (NextAuth)
# ============================================
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
# Local: http://localhost:3000 | Production: https://yourdomain.com
NEXTAUTH_URL=http://localhost:3000

# ============================================
# 🌐 GOOGLE CLOUD CONFIGURATION
# ============================================
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Must match one of the authorized redirect URIs in Google Console
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# The refresh token is required for the background sync engine to work.
GOOGLE_REFRESH_TOKEN=your_google_refresh_token

# Primary Google Drive folder ID to track
GOOGLE_DRIVE_FOLDER_ID=your_primary_folder_id_here

# ============================================
# 🗄️ DATABASE (Turso / LibSQL)
# ============================================
# Get these from: https://turso.tech
# Local development can also use: file:./dev.db
DATABASE_URL=file:./prisma/dev.db
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# ============================================
# 📢 NOTIFICATIONS & WEBHOOKS (Optional)
# ============================================
# Discord Webhook URL for instant new lead alerts
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Alternative Slack Webhook URL
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ============================================
# 📧 EMAIL SERVICE (Optional - Phase 4)
# ============================================
# Configuration for Postmark, SendGrid, or Resend
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_SERVER_HOST=smtp.postmarkapp.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your_smtp_username
EMAIL_SERVER_PASSWORD=your_smtp_password
EMAIL_FROM=noreply@yourdomain.com

# ============================================
# 🛠️ APP & SECURITY CONFIGURATION
# ============================================
# Secret required to trigger the /api/cron/sync endpoint
# Generate with: openssl rand -base64 32
CRON_SECRET=your_cron_secret_here

# Encryption key for storing Google OAuth tokens in the database
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=your_token_encryption_key_here

# Public API URL for the frontend
NEXT_PUBLIC_API_URL=http://localhost:3000

# Default role assigned to new leads discovered in Google Drive
# Options: viewer, editor, admin
DEFAULT_USER_ROLE=viewer

# 📊 TELEMETRY & ENRICHMENT (Optional)
# ============================================
OTEL_SERVICE_NAME=access-tracker-pulse
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.honeycomb.io
OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=your_api_key

# Lead enrichment via Clearbit
CLEARBIT_API_KEY=sk_your_clearbit_key_here
